# 安心童伴 v2.1 后端配置模板
# 复制为 .env（项目根目录）并填入真实值。config.py 只读环境变量 / 项目根 .env。

# —— LLM API Key（不配则进入脚本回退模式）——
DEEPSEEK_API_KEY="sk-..."

# —— 可选：自定义模型名（不配则用默认）——
# ANXIN_MAIN_MODEL="deepseek-v4-pro"    # 主回复（Step 5），默认 deepseek-v4-pro
# ANXIN_SMALL_MODEL="deepseek-chat"     # 轻量任务（分类/审计/摘要），默认 deepseek-chat

# —— JWT 签名密钥（生产必改！）——
# JWT_SECRET="please-change-me-to-a-long-random-string"

# —— 可选：SQLite 路径覆盖（默认 data/anxin.db）——
# ANXIN_DATABASE_URL="sqlite:///./data/anxin.db"
